# =============================================
# VARIÁVEIS DE AMBIENTE — DASHBOARD HM RIO
# =============================================

# --- META ADS (obrigatório para conectar) ---
# Token de acesso de longa duração (System User Token)
META_ACCESS_TOKEN=

# Conta de anúncios no formato act_XXXXXXXXXX
META_AD_ACCOUNT_ID=

# App ID do Meta App (usado para renovação de token)
META_APP_ID=

# App Secret do Meta App (usado para renovação de token)
META_APP_SECRET=

# --- GEMINI (opcional, para o assistente IA) ---
# Pegar em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
